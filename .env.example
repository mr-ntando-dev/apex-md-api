# ============================================================
#  APEX-MD · Environment Variables Template
#  Copy to .env and fill in your values.
#  NEVER commit your real .env to git.
# ============================================================

# ── Bot Identity ─────────────────────────────────────────────
BOT_NAME=APEX-MD
OWNER_NUMBER=2348012345678        # Your number without +
OWNER_NAME=Owner
BOT_PREFIX=.
PUBLIC_MODE=false

# ── REST API (NEW) ────────────────────────────────────────────
# All /api/* requests require:  X-API-Key: <API_SECRET>
API_SECRET=change_me_to_something_very_strong_and_random
API_PORT=3000
API_ENABLED=true

# ── AI Keys — at least one required ──────────────────────────
OPENAI_API_KEY=sk-...             # platform.openai.com
CLAUDE_API_KEY=sk-ant-...         # console.anthropic.com
GEMINI_API_KEY=AIza...            # aistudio.google.com (free tier available)

# ── Optional AI keys ─────────────────────────────────────────
ELEVENLABS_API_KEY=               # elevenlabs.io  (AI voice notes)
STABILITY_API_KEY=                # stability.ai   (Stable Diffusion XL fallback)
PERPLEXITY_API_KEY=               # perplexity.ai  (live web search)

# AI router: auto | openai | claude | gemini
AI_ROUTER=auto

# ── Database ──────────────────────────────────────────────────
# Leave blank to use fast in-memory store (resets on restart)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/apexmd

# ── Media / Utility APIs ──────────────────────────────────────
TENOR_API_KEY=                    # tenor.com/developer  (anime GIFs -- free)
WEATHER_API_KEY=                  # openweathermap.org
NEWS_API_KEY=                     # newsapi.org
AUDD_API_KEY=                     # audd.io  (Shazam / song ID)
URLSCAN_API_KEY=                  # urlscan.io  (malware scan)

# ── Bot behaviour ────────────────────────────────────────────
AUTO_READ=true
AUTO_STATUS=true
AUTO_TYPING=true
DEFAULT_LANG=en
LOG_LEVEL=info
