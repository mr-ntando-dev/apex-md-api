# ============================================================
#  APEX-MD API  ·  Environment Variables Template
#  Render-deployed stateless REST API.
#
#  Copy to .env for local dev.  On Render, set these as
#  environment variables in the Render dashboard.
#  NEVER commit your real .env to git.
# ============================================================

# ── API Security ──────────────────────────────────────────────
# All /api/* endpoints require this header:  X-API-Key: <API_SECRET>
# Use a long random string — treat it like a password.
API_SECRET=change_me_to_something_very_strong_and_random

# ── Database (REQUIRED) ───────────────────────────────────────
# Must be the SAME MongoDB URI you set in apex-md-bot.
# This is the only connection between the API and the bot.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/apexmd

# ── Job Queue Timeout ─────────────────────────────────────────
# How long (ms) the API waits for the bot to execute a job.
# Default: 10000 (10 seconds).  Increase if your bot is slow.
# JOB_TIMEOUT_MS=10000

# ── Server ────────────────────────────────────────────────────
# Render sets PORT automatically — do not override it on Render.
# API_PORT=3000

# ── Logging ───────────────────────────────────────────────────
# LOG_LEVEL=info
